#!/bin/bash
# prttil - calls the s7-based main program with cli.scm.
#
# install needs root; depends, world, and diff are read-only.

case "${1:-}" in
    depends|world|diff|'')
        # read-only commands, no root needed
        ;;
    *)
        if [ "$(id -u)" -ne 0 ]; then
            echo "error: $0 $1 requires root" >&2
            exit 1
        fi
        ;;
esac

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -x "$self/prttil-main" ]; then
    exec "$self/prttil-main" "$self/scm/cli.scm" "$@"
else
    exec "$self/../lib/prttil/main" "$self/../lib/prttil/cli.scm" "$@"
fi
