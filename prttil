#!/bin/bash
# prttil - calls the s7-based repl with cli.scm.
#
# install needs root; depends, world, and diff are read-only.

case "${1:-}" in
    depends|world|diff|build|'')
        # read-only commands, no root needed
        ;;
    *)
        if [ "$(id -u)" -ne 0 ]; then
            echo "error: $0 $1 requires root" >&2
            exit 1
        fi
        ;;
esac

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -x "$self/repl" ]; then
    exec "$self/repl" "$self/scm/cli.scm" "$@"
else
    exec "$self/../lib/prttil/repl" "$self/../lib/prttil/cli.scm" "$@"
fi
